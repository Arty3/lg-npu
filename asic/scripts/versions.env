# Shared version pins for the Sky130 ASIC flow.
# Sourced by the install / setup scripts and by CI so local and CI stay aligned.

# open_pdks commit used by Volare to materialise sky130A.
# Must be a real commit from https://github.com/efabless/volare
SKY130_PDK_COMMIT=c6d73a35f524070e85faff4a6a9eef49553ebc2b

# sv2v: tag/branch checked out from https://github.com/zachjs/sv2v
SV2V_REF=v0.0.13

# sky130 OpenRAM macro pack: tag/branch checked out from
# https://github.com/efabless/sky130_sram_macros
SRAM_MACROS_REF=main

# List of macros we actually instantiate (see rtl/platform/sky130_sram_blackboxes.sv).
# Each name maps to a subdirectory in the macros repo with .v / .lef / .gds / .lib.
# Only the 2 KB 32x512 variant ships pre-built in efabless/sky130_sram_macros;
# larger logical buffers are composed by tiling N copies inside the wrappers.
SRAM_MACROS="sky130_sram_2kbyte_1rw1r_32x512_8"

# Library corner shipped with each macro that OpenLane reads.
SRAM_LIB_CORNER=TT_1p8V_25C
